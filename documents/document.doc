    bootstrap:
        1-navs and tabs - header
        2-layout grid - main
        3-list groups / flush
        4-Pesos em textos:
            fs (fontsize)
            fw-lighter
        5-Progress / labels
        6-Carousel
            Dark Variant 
            Card 
                Grid Cards 
        7-Forms 
            layout 
                Gutters
        8-Components 
            spinners - mostra em processamento - ex.bottons
        9-alerts 
            dismissing
        10-Icons 
            Check
            Mar 
            Phon 
            Menu / Bars 
            Close / X


